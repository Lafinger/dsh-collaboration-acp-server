[Unit]
Description=Temporary isolated DSH desktop DingTalk identity probe
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dsh-collab-test
Group=dsh-collab-test
WorkingDirectory=/srv/dsh-collaboration-test/mvp-pc-probe/workspace
Environment=HOME=/srv/dsh-collaboration-test/mvp-pc-probe
Environment=DSH_HOME=/srv/dsh-collaboration-test/mvp-pc-probe/dsh-home
Environment=DSH_TELEMETRY_DISABLED=1
UMask=0077
# __CANDIDATE_RUNTIME__ must be substituted with one verified fixed-SHA absolute candidate directory.
ExecStart=/usr/bin/node __CANDIDATE_RUNTIME__/node_modules/@deepseek-ai/dsh/lib/bin.js --profile collaboration-mvp-probe
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/dsh-collaboration-test/mvp-pc-probe
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
# Deliberately no Install section: not enabled at boot, no retry loop or production cutover.
