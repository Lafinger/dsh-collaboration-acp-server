{
  "name": "dsh-collaboration-acp-server",
  "version": "0.7.2-rc.7",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lafinger/dsh-collaboration-acp-server.git"
  },
  "homepage": "https://github.com/Lafinger/dsh-collaboration-acp-server#readme",
  "bugs": {
    "url": "https://github.com/Lafinger/dsh-collaboration-acp-server/issues"
  },
  "description": "DSH-hosted collaboration MVP: private HTTPS/WSS, official browser DingTalk QR auto-enrollment, stable members/sessions and fixed project-role administrator.",
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.0-rc.2"
  },
  "main": "src/server-plugin.mjs",
  "exports": {
    ".": "./src/server-plugin.mjs",
    "./runtime": "./src/dsh-runtime.mjs",
    "./service": "./src/service.mjs",
    "./connector": "./src/connector.mjs",
    "./protocol": "./src/protocol.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-collaboration-connect": "./src/connector-cli.mjs",
    "dsh-collaboration-admin": "./src/admin-cli.mjs",
    "dsh-collaboration-maintenance": "./src/maintenance-cli.mjs"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "business/lib",
    "business/docs",
    "assets/dingtalk-pc.js",
    "assets/THIRD-PARTY-NOTICES.txt",
    "scripts/check-config.mjs",
    "examples",
    "deploy/ubuntu",
    "docs",
    "GLOSSARY.md",
    "GLOSSARY-MAP.md",
    "README.md",
    "LICENSE",
    "PROVENANCE.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p business/tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "test:business": "tsc -p business/tsconfig.test.json --noEmitOnError && node --test business/lib-test/**/*.test.js",
    "test": "node --test test/*.test.mjs",
    "integration": "node --import ./scripts/official-loader.mjs --test test/*.integration.mjs",
    "check": "node scripts/check.mjs",
    "check:joint": "node --import ./scripts/official-loader.mjs --test test/joint/*.joint.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "config:check": "node scripts/check-config.mjs",
    "install:check": "node scripts/check-github-install.mjs",
    "check:mutations": "node scripts/check-mutations.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "24.19.2",
    "esbuild": "0.25.12",
    "fflate": "0.8.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-compaction-image-offload": "0.2.0-rc.2",
    "@deepseek-ai/node-addon-system": "0.1.2",
    "dingtalk-jsapi": "3.2.9",
    "fast-xml-parser": "5.11.1",
    "koffi": "3.1.1",
    "sharp": "0.35.5",
    "ws": "8.22.0"
  }
}
