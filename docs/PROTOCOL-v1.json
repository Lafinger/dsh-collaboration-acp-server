{
  "version": 1,
  "name": "dsh-collaboration-access",
  "transport": "JSON-RPC 2.0 over bounded UTF-8 NDJSON; SSH stdio on client, local socket on server",
  "scope": "limited ACP-shaped interface with workbench extensions, not full ACP compatibility",
  "methods": {
    "initialize": { "protocolVersion": 1, "clientCapabilities": {} },
    "workbench/whoami": { "response": ["account", "serviceId", "runtimePid"] },
    "session/new": { "clientCwd": "ignored", "clientMcp": "not mounted", "response": ["sessionId", "cwd", "_meta"] },
    "session/list": { "visibility": "only account-owned sessions" },
    "session/load": { "params": ["sessionId"], "behavior": "attach same session, never replacement or prompt replay" },
    "session/resume": { "params": ["sessionId"], "behavior": "same ownership checks as load" },
    "session/prompt": { "params": ["sessionId", "prompt:text[]", "_meta.requestId"], "deduplication": "reject duplicate requestId" },
    "session/cancel": { "params": ["sessionId"], "behavior": "cancel only active turn, no rollback" },
    "session/close": { "params": ["sessionId"], "behavior": "detach and persist, not erase" },
    "workbench/history": { "params": ["sessionId", "after"], "response": ["events", "status"] }
  },
  "notifications": { "session/update": ["sessionId", "update", "_meta.sequence"] },
  "connectorOnly": { "workbench/connect": "signed account ticket over local socket; never forwarded from client" },
  "noReplay": { "requestIdentity": "sha256(serviceId NUL account NUL localId NUL messageId)", "recovery": "attach/history only; never session/prompt" },
  "unsupported": ["images", "files", "client filesystem", "terminal callbacks", "client MCP", "shared editing", "mode switching"],
  "limits": { "frameBytes": 1048576, "promptCharacters": 262144, "ticketValidityMs": 30000 },
  "errors": { "-32001": "connection closed", "-32002": "timeout/outcome may be unknown", "-32003": "authentication failure", "-32004": "session unavailable to account", "-32005": "duplicate submission", "-32006": "restore before use", "-32007": "attached/running/draining", "-32008": "activation/restore failed", "-32009": "prompt failed/outcome may be unknown", "-32010": "cancelled before submit" }
}
